# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
# Adapted from the installed native MG24 Matter sample.
# Builds generate platform glue from this manifest using Studio's bundled SLC.
# The maintained cmake_gcc graph compiles that output and the application.
# This manifest records the production profile. scripts/build.py --console
# selects serial diagnostics in the checked-in native CMake build graph.
project_name: MailboxMotion
label: MailboxMotion
description: |
  Seeed Studio XIAO MG24 mailbox lid motion detector. Matter over Thread with
  BLE commissioning, an external Bosch BMA400, and optional LiPo reporting.
package: matter
quality: production
readme:
- {path: README.md}
source:
- {path: src/AppTask.cpp}
- {path: src/BatteryMonitor.cpp}
- {path: src/PlatformInit.c}
- {path: src/bma400/Bma400Motion.cpp}
- {path: src/bma400/bma400.c}
- {path: src/main.cpp}
- {path: src/DataModelCallbacks.cpp}
include:
- path: include
  file_list:
  - {path: AppConfig.h}
  - {path: AppEvent.h}
  - {path: AppTask.h}
  - {path: BatteryMonitor.h}
  - {path: CHIPProjectConfig.h}
- path: src/bma400
  file_list:
  - {path: Bma400Motion.h}
  - {path: bma400.h}
  - {path: bma400_defs.h}
sdk: {vendor: null, id: simplicity_sdk, version: 2025.6.2}
toolchain_settings:
- {value: gnu++17, option: cxx_standard}
component:
- {from: matter, id: app_common}
- {from: matter, id: matter}
- {from: matter, id: matter_access_control}
- {from: matter, id: matter_administrator_commissioning}
- {from: matter, id: matter_basic_information}
- {from: matter, id: matter_ble}
- {from: matter, id: matter_buttons}
- {from: matter, id: matter_configuration_over_swo}
- {from: matter, id: matter_crypto}
- {from: matter, id: matter_default_lcd_config}
- {from: matter, id: matter_descriptor}
- {from: matter, id: matter_diagnostic_logs}
- {from: matter, id: matter_occupancy_sensor}
- {from: matter, id: matter_ethernet_network_diagnostics}
- {from: matter, id: matter_fixed_label}
- {from: matter, id: matter_gatt_static}
- {from: matter, id: matter_general_commissioning}
- {from: matter, id: matter_general_diagnostics}
- {from: matter, id: matter_group_key_mgmt}
- {from: matter, id: matter_groups}
- {from: matter, id: matter_icd_core}
- {from: matter, id: matter_icd_management}
- {from: matter, id: matter_identify}
- {from: matter, id: matter_localization_configuration}
- {from: matter, id: matter_log_rtt}
- {from: matter, id: matter_network_commissioning}
- {from: matter, id: matter_operational_credentials}
- {from: matter, id: matter_ota_requestor}
- {from: matter, id: matter_ota_support}
- {from: matter, id: matter_platform_mg}
- {from: matter, id: matter_power_source}
- {from: matter, id: matter_power_source_configuration}
- {from: matter, id: matter_provision_default}
- {from: matter, id: matter_segger_rtt}
- {from: matter, id: matter_software_diagnostics}
- {from: matter, id: matter_test_event_trigger}
- {from: matter, id: matter_thread}
- {from: matter, id: matter_thread_network_diagnostics}
- {from: matter, id: matter_time_format_localization}
- {from: matter, id: matter_unit_localization}
- {from: matter, id: matter_user_label}
- {from: matter, id: matter_wifi_network_diagnostics}
- {id: EFR32MG24B220F1536IM48}
- {id: clock_manager}
- {id: device_init}
- {id: i2cspm_core}
- {id: gpiointerrupt}
- {id: emlib_iadc}
- {id: ot_stack_mtd}
- {id: rail_util_pti}
- {id: sl_main}
- {id: uartdrv_eusart, instance: [vcom]}
- {id: simple_led, instance: [inst0]}
- {id: iostream_rtt}
- {id: ot_cli_source}
define:
- {name: CHIP_CRYPTO_PLATFORM, value: '1'}
- {name: _WANT_REENT_SMALL, value: '1'}
- {name: MAILBOX_CONSOLE_KEEP_AWAKE, value: '0'}
- {name: CHIP_DEVICE_CONFIG_THREAD_ENABLE_CLI, value: '0'}
- {name: MAILBOX_BATTERY_INSTALLED, value: '0'}
- {name: NVM3_DEFAULT_NVM_SIZE, value: '40960'}
- {name: NVM3_DEFAULT_MAX_OBJECT_SIZE, value: '4092'}
config_file:
- {path: config/common/mailbox-motion.zap, directory: common}
- {path: config/provision/provision.mattpconf, directory: provision}
requires:
- {name: matter_drivers_series_2}
configuration:
- condition: [matter_ble_side_channel]
  name: SL_BT_CONFIG_USER_ADVERTISERS
  value: '2'
- condition: [device_series_3]
  name: SL_TOKEN_MANAGER_STATIC_SECURE_TOKEN_SIZE
  value: '8192'
- {name: SL_OPENTHREAD_ENABLE_APP_TASK, value: '0'}
- {name: SL_OPENTHREAD_ENABLE_CLI_TASK, value: '0'}
- {name: SL_OPENTHREAD_ENABLE_SERIAL_TASK, value: '0'}
- {name: SL_POWER_MANAGER_INIT_EMU_EM2_DEBUG_ENABLE, value: '0'}
- {name: SL_DEVICE_INIT_DCDC_ENABLE, value: '0'}
- {name: SL_MATTER_LOG_LEVEL, value: SL_MATTER_LOG_PROGRESS}
- {name: OPENTHREAD_CONFIG_LOG_OUTPUT, value: OPENTHREAD_CONFIG_LOG_OUTPUT_APP}
- condition: [matter_thread_cert_libs]
  name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
  value: '1'
- {name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED, value: '1'}
- condition: [matter_thread_coap_cert_libs]
  name: OPENTHREAD_CONFIG_COAP_API_ENABLE
  value: '1'
- condition: [matter_thread_coap_cert_libs]
  name: OPENTHREAD_CONFIG_COAP_OBSERVE_API_ENABLE
  value: '1'
- condition: [matter_thread_coap_cert_libs]
  name: OPENTHREAD_CONFIG_COAP_SECURE_API_ENABLE
  value: '1'
- {name: SL_STACK_SIZE, value: '4608'}
- unless: [device_series_3]
  name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
  value: '1536'
- condition: [device_series_3]
  name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
  value: '1856'
- {name: SL_IDLE_MODE_DURATION_S, value: '600'}
- {name: SL_ACTIVE_MODE_DURATION_MS, value: '0'}
- {name: SL_ACTIVE_MODE_THRESHOLD, value: '0'}
- {name: SL_TRANSPORT_IDLE_INTERVAL, value: '15000'}
- {name: SL_TRANSPORT_ACTIVE_INTERVAL, value: '200'}
- {name: CIRCULAR_QUEUE_LEN_MAX, value: '16'}
- {name: SL_MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS, value: '1'}
- {name: CHIP_CONFIG_SYNCHRONOUS_REPORTS_ENABLED, value: '1'}
- {name: CHIP_CONFIG_SUBSCRIPTION_TIMEOUT_RESUMPTION, value: '0'}
# Short Idle Time ICD; no Long Idle Time, check-in protocol, or UAT.
- {name: CHIP_CONFIG_ENABLE_ICD_LIT, value: '0'}
- {name: CHIP_CONFIG_ENABLE_ICD_CIP, value: '0'}
- {name: CHIP_CONFIG_ENABLE_ICD_UAT, value: '0'}
- {name: CHIP_CONFIG_ENABLE_ICD_DSLS, value: '0'}
# XIAO USB serial bridge and onboard LED. I2C/INT pins are initialized by AppTask.
- {name: SL_CLOCK_MANAGER_HFXO_FREQ, value: '39000000'}
- {name: SL_CLOCK_MANAGER_HFXO_CTUNE, value: '95'}
- {name: SL_CLOCK_MANAGER_LFXO_EN, value: '1'}
- {name: SL_CLOCK_MANAGER_LFXO_CTUNE, value: '44'}
- {name: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE, value: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_LFXO}
- {name: SL_UARTDRV_EUSART_VCOM_PERIPHERAL, value: EUSART0}
- {name: SL_UARTDRV_EUSART_VCOM_PERIPHERAL_NO, value: '0'}
- {name: SL_UARTDRV_EUSART_VCOM_TX_PORT, value: SL_GPIO_PORT_A}
- {name: SL_UARTDRV_EUSART_VCOM_TX_PIN, value: '8'}
- {name: SL_UARTDRV_EUSART_VCOM_RX_PORT, value: SL_GPIO_PORT_A}
- {name: SL_UARTDRV_EUSART_VCOM_RX_PIN, value: '9'}
- {name: SL_UARTDRV_EUSART_VCOM_FLOW_CONTROL_TYPE, value: uartdrvFlowControlNone}
- {name: SL_UARTDRV_EUSART_VCOM_BAUDRATE, value: '115200'}
- {name: SL_SIMPLE_LED_INST0_PORT, value: SL_GPIO_PORT_A}
- {name: SL_SIMPLE_LED_INST0_PIN, value: '7'}
- {name: SL_SIMPLE_LED_INST0_POLARITY, value: SL_SIMPLE_LED_POLARITY_ACTIVE_LOW}
ui_hints:
  highlight:
  - {path: README.md}
sdk_extension:
- {vendor: null, id: matter, version: 2.7.0}
