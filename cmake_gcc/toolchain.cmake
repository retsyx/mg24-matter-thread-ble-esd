set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{ARM_GCC_DIR})
  message(FATAL_ERROR "ARM_GCC_DIR must identify the installed ARM GCC package")
endif()
set(TOOLCHAIN_DIR "$ENV{ARM_GCC_DIR}/bin")
foreach(pair "C_COMPILER;gcc" "CXX_COMPILER;g++" "ASM_COMPILER;gcc" "AR;ar" "OBJCOPY;objcopy" "SIZE_UTIL;size" "RANLIB;ranlib")
  list(GET pair 0 var)
  list(GET pair 1 exe)
  set(CMAKE_${var} "${TOOLCHAIN_DIR}/arm-none-eabi-${exe}")
endforeach()
